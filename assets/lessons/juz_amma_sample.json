{"lessons": [{"id": "juzamma-lesson-0", "instruction": {"ar": "استمع إلى كل آية ثم رددها", "en": "Listen to each ayah, then repeat it", "ur": "ہر آیت سنیں پھر دہرائیں"}, "steps": [{"ayahNumber": 1, "globalAyahNumber": 1, "meaning": {"ar": "بسم الله الرحمن الرحيم", "en": "In the name of Allah, the Most Gracious, the Most Merciful", "ur": "اللہ کے نام سے جو بڑا مہربان نہایت رحم والا ہے"}, "text": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ", "transliteration": "Bismillaahir-Rahmaanir-Raheem"}, {"ayahNumber": 2, "globalAyahNumber": 2, "meaning": {"ar": "الحمد لله رب العالمين", "en": "All praise is due to Allah, Lord of the worlds", "ur": "سب تعریف اللہ کے لیے ہے جو تمام جہانوں کا رب ہے"}, "text": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ", "transliteration": "Alhamdu lillaahi Rabbil-'aalameen"}], "type": "listenRepeat", "worldId": "juzamma"}, {"id": "juzamma-lesson-1", "instruction": {"ar": "رتب الآيات بالترتيب الصحيح", "en": "Put the ayat in the right order", "ur": "آیات کو صحیح ترتیب میں لگائیں"}, "steps": [{"ayahNumber": 1, "data": {"shuffled": ["اللَّهُ الصَّمَدُ", "قُلْ هُوَ اللَّهُ أَحَدٌ"]}, "globalAyahNumber": 6222, "text": "قُلْ هُوَ اللَّهُ أَحَدٌ"}, {"ayahNumber": 2, "globalAyahNumber": 6223, "text": "اللَّهُ الصَّمَدُ"}], "type": "ayahOrder", "worldId": "juzamma"}], "worlds": [{"id": "juzamma", "nodes": [{"id": "juzamma-node-0", "isBoss": false, "lessonId": "juzamma-lesson-0", "order": 0, "worldId": "juzamma"}, {"id": "juzamma-node-1", "isBoss": true, "lessonId": "juzamma-lesson-1", "order": 1, "worldId": "juzamma"}], "title": {"ar": "جزء عم", "en": "Juz Amma", "ur": "جز عم"}}]}